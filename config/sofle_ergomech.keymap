// Define pointing magnitudes before including the pointing header.
// MOVE_VAL sets the magnitude of MOVE_* codes (default 600); we only use it
// via encoder_scroll_alt's `&msc MOVE_UP/DOWN` smooth-scroll trick, where it
// acts as the per-detent scroll amount. SCRL_VAL sets ordinary &msc tick size.

#define ZMK_POINTING_DEFAULT_MOVE_VAL 240
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12

// Include pointing device bindings for mouse scroll

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define WORK 3
#define SYSTEM 4

/ {
    // Activate SYSTEM by holding both inner thumbs (LOWER + RAISE tri-layer)

    conditional_layers {
        compatible = "zmk,conditional-layers";

        system_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <SYSTEM>;
        };
    };

    behaviors {
        // Smooth-scroll encoder behavior using MOVE values

        encoder_scroll_alt: encoder_scroll_alt {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc MOVE_UP>, <&msc MOVE_DOWN>;

            tap-ms = <50>;
        };

        // LOWER is a plain &mo on the thumb (instant, no tap-dance arbitration).
        // RAISE keeps a tap dance so double-tap-hold reaches WORK (RDP chords).
        td_layer_work: tap_dance_layer_work {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <100>;
            bindings = <&mo RAISE>, <&mo WORK>;
        };

        // Window minimize/maximize encoder behavior (used in raise_layer)
        win_vertical_encoder: win_vertical_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp LG(DOWN)>, <&kp LG(UP)>;
        };

        // Plain modified keypresses (COSMIC window management, copy/paste,
        // ctrl-alt chords) are bound directly as &kp LG(...)/LC(...) in the
        // layers below - no macros needed, and held keys get host auto-repeat.

        // ALT tap dance behavior - single tap ALT, double tap play/pause
        // (left outer thumb only; right outer thumb is a dedicated Alt+Tab)
        td_alt_media: tap_dance_alt_media {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <100>;
            bindings = <&kp LALT>, <&kp C_PLAY_PAUSE>;
            label = "TAP_DANCE_ALT_MEDIA";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "default";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   -   |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |                   |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //         | -   | ALT | GUI  | CTRL | SPACE| LOWER  | RSE/WORK | ENTER| RCTRL |K_CMENU| A+TAB |
            // (ALT = tap dance: tap ALT, double-tap play/pause. A+TAB = Alt+Tab; hold to cycle via key repeat.)

            bindings = <
&kp GRAVE   &kp N1    &kp N2    &kp N3           &kp N4     &kp N5         &kp N6          &kp N7     &kp N8        &kp N9    &kp N0    &kp MINUS
&kp ESC     &kp Q     &kp W     &kp E            &kp R      &kp T          &kp Y           &kp U      &kp I         &kp O     &kp P     &kp BACKSPACE
&kp TAB     &kp A     &kp S     &kp D            &kp F      &kp G          &kp H           &kp J      &kp K         &kp L     &kp SEMI  &kp SQT
&kp LSHIFT  &kp Z     &kp X     &kp C            &kp V      &kp B          &kp N           &kp M      &kp COMMA     &kp DOT   &kp FSLH  &kp RSHIFT
&none       &td_alt_media  &kp LGUI  &kp LCTRL        &kp SPACE  &mo LOWER      &td_layer_work  &kp ENTER  &kp RCTRL     &kp K_CMENU  &kp LA(TAB)
                                                                           &none           &none      &none         &none     &none
            >;

            sensor-bindings = <&encoder_scroll_alt>;
        };

        lower_layer {
            label = "lower";

            // ------------------------------------------------------------------------------------------------------------
            // |  F1   |  F2  |  F3  |  F4  |  F5  |  F6   |             |  F7  |  F8 |  F9 |  F10 |  F11 |  F12  |
            // | BKSPC |      | MB4  |      | MB5  | PASTE'|             |  7   |  8  |  9  |  (   |  )   | BKSPC |
            // |  INS  |      | MB2  | MB3  | MB1  | COPY  |             |  4   |  5  |  6  |  [   |  ]   |   |   |
            // |       | BT0  | BT1  | BT2  | BT3  | BT4   |             |  1   |  2  |  3  |  {   |  }   |   =   |
            //         |      |      |      |      |       |             |  +   |  0  |  /  |  .   |  *   |
            // (PASTE' = plain paste Ctrl+Shift+V; MBx = mouse buttons; BTx = BLE profile select)

            bindings = <
&kp F1         &kp F2        &kp F3        &kp F4        &kp F5        &kp F6         &kp F7    &kp F8   &kp F9     &kp F10               &kp F11            &kp F12
&kp BACKSPACE  &trans        &mkp MB4      &trans        &mkp MB5      &kp LC(LS(V))  &kp N7    &kp N8   &kp N9     &kp LEFT_PARENTHESIS  &kp RPAR           &kp BACKSPACE
&kp INS        &trans        &mkp MB2      &mkp MB3      &mkp MB1      &kp LC(C)      &kp N4    &kp N5   &kp N6     &kp LEFT_BRACKET      &kp RIGHT_BRACKET  &kp PIPE
&trans         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4   &kp N1    &kp N2   &kp N3     &kp LEFT_BRACE        &kp RIGHT_BRACE    &kp EQUAL
&trans         &trans        &trans        &trans        &trans        &trans         &kp PLUS  &kp N0   &kp SLASH  &kp PERIOD            &kp ASTERISK
                                                                                      &none     &none    &none      &none                 &none
            >;

            sensor-bindings = <&inc_dec_kp DOWN UP>;
        };

        raise_layer {
            label = "raise";

            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |          |      |      |      |      |      |   +   |
            // |       |     |     |      |      |      |          |  \   | HOME | PGDN | PGUP | END  |  DEL  |
            // |       |     |     |      |      |      |          |      |  <-  |  v   |  ^   |  ->  |       |
            // |       |     |     |      |      |      |          |      |      |      |      |      |       |
            //         |     |     |      |      |      |          |      |      |      |      |
            // Encoder: window minimize/maximize (GUI+Down / GUI+Up). Trackpad scrolls on this layer.

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans         &trans    &trans    &trans     &trans     &kp PLUS
&trans  &trans  &trans  &trans  &trans  &trans  &kp BACKSLASH  &kp HOME  &kp PG_DN &kp PG_UP  &kp END    &kp DEL
&trans  &trans  &trans  &trans  &trans  &trans  &trans         &kp LEFT  &kp DOWN  &kp UP     &kp RIGHT  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans         &trans    &trans    &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans            &trans      &trans    &trans          &trans
                                                &none     &none    &none      &none                 &none
            >;

            sensor-bindings = <&win_vertical_encoder>;
        };

        work_layer {
            label = "work";

            // Ctrl+Alt chords (KVM / remote-session control) + NumLock
            // ------------------------------------------------------------------------------------------------------------
            // |  |  |  |  |  |  |          |         |        |       |        |     |  |
            // |  |  |  |  |  |  |          |         |        |       | NUMLK  |     |  |
            // |  |  |  |  |  |  |          | C-A-Brk | C-A-End| C-A-D |        |     |  |
            // |  |  |  |  |  |  |          |         |        |       |        |     |  |
            //    |  |  |  |  |  |          |         |        |       |        |
            // Encoder: volume down/up

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                   &trans           &trans           &trans      &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                   &trans           &trans           &kp KP_NUM  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LC(LA(PAUSE_BREAK))  &kp LC(LA(END))  &kp LC(LA(DEL))  &trans      &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                   &trans           &trans           &trans      &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                   &trans           &trans           &trans
                                                &none   &none                    &none            &none            &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        system_layer {
            label = "system";

            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                |      |      |       |      |       |       |
            // |       |     |     |      |      |      |                |      |      |       |      |       |       |
            // |       |     |     |      |      |      |                |      |      |       |      |       |       |
            // |       |     |     |      |      |      |                |      |      |       |      |       |       |
            //               |     |      |      |      |                |      |      |       |      |

            bindings = <
&kp F1  &kp F2        &kp F3        &kp F4        &kp F5        &kp F6        &kp F7      &kp F8   &kp F9   &kp F10          &kp F11  &kp F12
&trans  &trans        &trans        &trans        &trans        &trans        &bt BT_CLR  &trans   &trans   &trans           &trans   &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans      &trans   &trans   &trans           &trans   &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans      &kp DEL  &kp END  &kp PAUSE_BREAK  &kp ESC  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans      &trans   &trans   &trans           &trans
                                                                              &none       &none    &none    &none            &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

    };

};

&glidepoint_listener {
    raise_scroll_override {
        layers = <RAISE>;
        input-processors = <&zip_xy_scaler 1 4>, <&zip_xy_to_scroll_mapper>;
    };
};
